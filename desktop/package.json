{
  "name": "transit-overlay",
  "productName": "Transit Overlay",
  "version": "2.7.1",
  "description": "Draw and analyse transit networks over map screenshots or live Transport Fever 3 data.",
  "main": "main.js",
  "author": "Axel Ferb",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "se.axel.transitoverlay",
    "productName": "Transit Overlay",
    "files": [
      "main.js",
      "preload.js",
      "logtools.js",
      "app/**"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "TransitOverlay-portable.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "artifactName": "TransitOverlay-linux-x86_64.AppImage"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/axelferb/Transport-Fever-3---Transit-Overlay"
  }
}
