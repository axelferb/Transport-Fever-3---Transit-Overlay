{
  "name": "transit-overlay",
  "productName": "Transit Overlay",
  "version": "2.4.0",
  "description": "Draw and analyse transit networks over map screenshots or live Transport Fever 3 data.",
  "main": "main.js",
  "author": "Axel",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "se.axel.transitoverlay",
    "productName": "Transit Overlay",
    "files": [
      "main.js",
      "preload.js",
      "logtools.js",
      "app/**"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "TransitOverlay-${version}-portable.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/axelferb/Transport-Fever-3---Transit-Overlay"
  }
}
